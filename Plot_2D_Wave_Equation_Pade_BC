import numpy as np
import matplotlib.pyplot as plt
import torch

# 1. Full training loop with loss tracking
loss_history = []
model.train()

for epoch in range(2000):
    domain, bc, ic = generate_points()
    optimizer.zero_grad()
    loss = compute_loss(model, *domain, *bc, *ic, n=n_order)
    loss.backward()
    optimizer.step()
    loss_history.append(loss.item())

# 2. Evaluate model on a dense 2D meshgrid
model.eval()
t_vec = np.linspace(0, 1, 100)
x_vec = np.linspace(0, 1, 100)
T, X = np.meshgrid(t_vec, x_vec)

t_tensor = torch.tensor(T.flatten()[:, None], dtype=torch.float32)
x_tensor = torch.tensor(X.flatten()[:, None], dtype=torch.float32)

with torch.no_grad():
    U_flat = model(t_tensor, x_tensor).numpy()

U = U_flat.reshape(T.shape)

# 3. Multi-panel plotting
fig, axes = plt.subplots(1, 3, figsize=(16, 4.5))

# Loss Convergence Plot
axes[0].semilogy(loss_history, color='crimson')
axes[0].set_xlabel("Epoch")
axes[0].set_ylabel("Loss")
axes[0].set_title("Training Loss Curve")
axes[0].grid(True, which="both", ls="--", alpha=0.5)

# 2D Heatmap u(t, x)
mesh = axes[1].pcolormesh(T, X, U, shading="auto", cmap="viridis")
fig.colorbar(mesh, ax=axes[1], label="u(t, x)")
axes[1].set_xlabel("Time (t)")
axes[1].set_ylabel("Space (x)")
axes[1].set_title("2D Field Solution u(t, x)")

# Spatial Snapshots at Selected Time Slices
for t_val in [0.0, 0.25, 0.5, 0.75, 1.0]:
    t_idx = int(t_val * 99)
    axes[2].plot(x_vec, U[:, t_idx], label=f"t = {t_val:.2f}")

axes[2].set_xlabel("Space (x)")
axes[2].set_ylabel("u(t, x)")
axes[2].set_title("1D Profiles Across Time")
axes[2].legend()
axes[2].grid(True, alpha=0.3)

plt.tight_layout()
plt.show()
