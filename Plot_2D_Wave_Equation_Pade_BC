# Grid setup for animation
res = 50
x_g = np.linspace(0, 1, res)
y_g = np.linspace(0, 1, res)
X, Y = np.meshgrid(x_g, y_g)
grid_xy = np.stack([X.ravel(), Y.ravel()], axis=1)

t_steps = 60
t_vals = np.linspace(0, 1, t_steps)

fig = plt.figure(figsize=(10, 7))
ax = fig.add_subplot(111, projection='3d')

def update(frame):
    ax.clear()
    t_curr = t_vals[frame]
    t_col = np.full((res * res, 1), t_curr)
    txy_eval = torch.tensor(np.hstack([t_col, grid_xy]), dtype=torch.float32)
    
    with torch.no_grad():
        u_pred = model(txy_eval)[:, 0].numpy().reshape(res, res)
        
    surf = ax.plot_surface(X, Y, u_pred, cmap='viridis', edgecolor='none', vmin=-0.2, vmax=1.0)
    ax.set_zlim(-0.3, 1.0)
    ax.set_title(f"Wave Propagation with Order-{n} Absorbing BC (t = {t_curr:.2f})")
    ax.set_xlabel("X")
    ax.set_ylabel("Y")
    ax.set_zlabel("u(t, x, y)")
    return surf,

anim = FuncAnimation(fig, update, frames=t_steps, interval=80, blit=False)
anim.save("pinn_wave_3d_n=4.gif", writer="pillow", fps=15)
plt.close()
