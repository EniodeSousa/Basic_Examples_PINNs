import numpy as np
from scipy.optimize import minimize

def optimize_angles(n: int, max_deg: float = 75.0) -> np.ndarray:
    max_rad = np.radians(max_deg)
    theta_grid = np.linspace(0, max_rad, 1000)
    cos_theta = np.cos(theta_grid)[:, None]

    def max_reflection(angles):
        cos_angles = np.cos(angles)[None, :]
        num = np.abs(cos_theta - cos_angles)
        den = cos_theta + cos_angles
        R = np.prod(num / den, axis=1)
        return np.max(R)

    x0 = np.linspace(0.05, max_rad - 0.05, n)
    bounds = [(0.0, max_rad) for _ in range(n)]
    res = minimize(max_reflection, x0, bounds=bounds, method='L-BFGS-B')
    return np.sort(res.x)
